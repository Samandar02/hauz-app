# Appwrite Configuration for HAUZ Application

# Appwrite API Endpoint (default for cloud: https://cloud.appwrite.io/v1)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (Found in Appwrite Console > Project Settings)
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# HAUZ Database & Collection IDs (Configured by setup script)
VITE_APPWRITE_DATABASE_ID=hauz_db
VITE_APPWRITE_COLLECTION_ROLES_ID=personal_roles
VITE_APPWRITE_COLLECTION_ACCOUNTS_ID=accounts
VITE_APPWRITE_COLLECTION_GRANTS_ID=account_access_grants
VITE_APPWRITE_COLLECTION_PERSONAL_ACCOUNTS_ID=personal_accounts

# Appwrite Secret API Key (Required ONLY for running 'npm run setup:appwrite' or server functions)
# Create in Appwrite Console > Project Settings > View API Keys > Create Secret API Key
# Required Scopes: databases.read, databases.write, collections.read, collections.write, attributes.read, attributes.write, indexes.read, indexes.write, documents.read, documents.write
APPWRITE_API_KEY=your_secret_api_key_here
